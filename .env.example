# CONTRACTAI Environment Configuration

PROJECT_NAME=CONTRACTAI
API_V1_STR=/api
SECRET_KEY=contractai_super_secret_jwt_key_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (Uses SQLite by default if POSTGRES_SERVER is not set)
DATABASE_URL=sqlite:///./storage/contract_ai.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contract_ai

# Storage
STORAGE_DIR=./storage
UPLOAD_DIR=./storage/uploads
REPORT_DIR=./storage/reports
VECTOR_DB_DIR=./storage/vector_db

# LLM & RAG Settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
USE_OLLAMA=false

# Risk Engine Weight Configuration (Sum = 1.0)
WEIGHT_RULES=0.40
WEIGHT_LLM=0.40
WEIGHT_RAG=0.20
